@model IEnumerable<Consulta>
@{ ViewData["Title"] = "Consultas"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Consultas</h1><a class="btn btn-caramelo" asp-action="Create">Agendar consulta</a></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Data e hora</th><th>Animal</th><th>Veterinário</th><th>Motivo</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Animal?.Nome</td><td>@item.Veterinario?.Nome</td><td>@item.Motivo</td><td><span class="badge @(item.Status == "Concluída" ? "text-bg-success" : item.Status == "Cancelada" ? "text-bg-secondary" : "text-bg-warning")">@item.Status</span></td><td class="text-end text-nowrap"><a asp-controller="Relatorios" asp-action="Consulta" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">Relatório</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a></td></tr> }
</tbody></table></div></div>
