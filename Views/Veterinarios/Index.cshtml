@model IEnumerable<Veterinario>
@{ ViewData["Title"] = "Veterinários"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Veterinários</h1><a class="btn btn-caramelo" asp-action="Create">Novo veterinário</a></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nome</th><th>CRMV</th><th>Especialidade</th><th>E-mail</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Crmv</td><td>@item.Especialidade</td><td>@item.Email</td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a></td></tr> }
</tbody></table></div></div>
