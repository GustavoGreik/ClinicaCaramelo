@model Animal
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Especie" class="form-label"></label><select asp-for="Especie" class="form-select"><option value="">Selecione</option><option>Cachorro</option><option>Gato</option><option>Coelho</option><option>Passáro</option><option>Outro</option></select><span asp-validation-for="Especie" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Raca" class="form-label"></label><input asp-for="Raca" class="form-control" /><span asp-validation-for="Raca" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Idade" class="form-label"></label><input asp-for="Idade" class="form-control" type="number" min="0" max="100" /><span asp-validation-for="Idade" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Sexo" class="form-label"></label><select asp-for="Sexo" class="form-select"><option value="">Não informado</option><option>Macho</option><option>Fêmea</option></select></div>
<div class="mb-3"><label asp-for="TutorId" class="form-label"></label><select asp-for="TutorId" class="form-select" asp-items="ViewBag.TutorId"><option value="">Selecione um tutor</option></select><span asp-validation-for="TutorId" class="text-danger"></span></div>
