@model IEnumerable<Animal>
@{ ViewData["Title"] = "Animais"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Animais</h1><a class="btn btn-caramelo" asp-action="Create">Novo animal</a></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Nome</th><th>Espécie</th><th>Raça</th><th>Idade</th><th>Tutor</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Nome</td><td>@item.Especie</td><td>@item.Raca</td><td>@(item.Idade.HasValue ? item.Idade + " ano(s)" : "—")</td><td>@item.Tutor?.Nome</td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a></td></tr> }
</tbody></table></div></div>
