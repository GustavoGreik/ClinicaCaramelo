@model Tutor
@{ ViewData["Title"] = "Excluir tutor"; }
<div class="card border-danger"><div class="card-body"><h1 class="h4">Excluir tutor</h1><p>Deseja realmente excluir o cadastro de <strong>@Model.Nome</strong>?</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Confirmar exclusão</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div></div>
