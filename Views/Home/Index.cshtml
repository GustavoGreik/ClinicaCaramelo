@{
    ViewData["Title"] = "Início";
}
<section class="hero p-4 p-md-5 mb-4">
    <span class="small text-uppercase fw-semibold">Bem-vindo à</span>
    <h1 class="display-5 fw-bold mt-2">Clínica Caramelo</h1>
    <p class="lead mb-0">Organizando os cuidados de quem faz parte da família.</p>
</section>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Tutores</span><strong>@ViewBag.TotalTutores</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Animais</span><strong>@ViewBag.TotalAnimais</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Veterinários</span><strong>@ViewBag.TotalVeterinarios</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Consultas hoje</span><strong>@ViewBag.ConsultasHoje</strong></div></div>
</div>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-caramelo" asp-controller="Consultas" asp-action="Create">Agendar consulta</a>
    <a class="btn btn-outline-secondary" asp-controller="Animais" asp-action="Create">Cadastrar animal</a>
    <a class="btn btn-outline-secondary" asp-controller="Tutores" asp-action="Create">Cadastrar tutor</a>
</div>
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Próximas consultas</h2></div>
    <div class="card-body">
    @if (ViewBag.ProximasConsultas.Count == 0)
    {
        <p class="text-muted mb-0">Nenhuma consulta agendada por enquanto.</p>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle mb-0">
            <thead><tr><th>Data</th><th>Animal</th><th>Veterinário</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (Consulta consulta in ViewBag.ProximasConsultas)
            {
                <tr><td>@consulta.DataHora.ToString("dd/MM/yyyy HH:mm")</td><td>@consulta.Animal?.Nome</td><td>@consulta.Veterinario?.Nome</td><td><span class="badge text-bg-warning">@consulta.Status</span></td></tr>
            }
            </tbody>
        </table></div>
    }
    </div>
</div>
