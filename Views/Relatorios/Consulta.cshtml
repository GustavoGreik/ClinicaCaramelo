@model Consulta
@{ ViewData["Title"] = "Relatório da consulta"; }
<div class="d-flex justify-content-between align-items-center mb-3 no-print"><h1 class="h3">Relatório da consulta</h1><button class="btn btn-caramelo" onclick="window.print()">Imprimir / Salvar PDF</button></div>
<div class="report-sheet p-4 p-md-5 bg-white">
<div class="d-flex justify-content-between border-bottom pb-3 mb-4"><div><h1 class="h3 mb-1">Clínica Caramelo</h1><p class="text-muted mb-0">Relatório de atendimento veterinário</p></div><div class="text-end"><strong>Consulta #@Model.Id</strong><div>@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</div></div></div>
<h2 class="h5">Dados do animal</h2><div class="row mb-4"><div class="col-sm-6"><strong>Nome:</strong> @Model.Animal?.Nome</div><div class="col-sm-6"><strong>Espécie:</strong> @Model.Animal?.Especie</div><div class="col-sm-6"><strong>Raça:</strong> @(Model.Animal?.Raca ?? "Não informada")</div><div class="col-sm-6"><strong>Idade:</strong> @(Model.Animal?.Idade?.ToString() ?? "Não informada")</div></div>
<h2 class="h5">Dados do tutor / cliente</h2><div class="row mb-4"><div class="col-sm-6"><strong>Nome:</strong> @Model.Animal?.Tutor?.Nome</div><div class="col-sm-6"><strong>CPF:</strong> @Model.Animal?.Tutor?.Cpf</div><div class="col-sm-6"><strong>E-mail:</strong> @Model.Animal?.Tutor?.Email</div><div class="col-sm-6"><strong>Telefone:</strong> @Model.Animal?.Tutor?.Telefone</div></div>
<h2 class="h5">Profissional responsável</h2><div class="row mb-4"><div class="col-sm-6"><strong>Veterinário:</strong> @Model.Veterinario?.Nome</div><div class="col-sm-6"><strong>CRMV:</strong> @Model.Veterinario?.Crmv</div><div class="col-sm-6"><strong>Especialidade:</strong> @Model.Veterinario?.Especialidade</div></div>
<h2 class="h5">Atendimento</h2><p><strong>Motivo:</strong> @Model.Motivo</p><p><strong>Status:</strong> @Model.Status</p><p><strong>Observações:</strong><br/>@(string.IsNullOrWhiteSpace(Model.Observacoes) ? "Nenhuma observação registrada." : Model.Observacoes)</p>
<div class="row mt-5 pt-4"><div class="col-6 text-center"><div class="border-top pt-2">Assinatura do tutor</div></div><div class="col-6 text-center"><div class="border-top pt-2">Assinatura do veterinário</div></div></div>
</div>
