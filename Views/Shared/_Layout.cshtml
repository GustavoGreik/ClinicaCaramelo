<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clínica Caramelo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark caramelo-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Clínica Caramelo</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Tutores" asp-action="Index">Tutores</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Animais" asp-action="Index">Animais</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Veterinarios" asp-action="Index">Veterinários</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Consultas" asp-action="Index">Consultas</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Consultas" asp-action="Index">Relatórios</a></li>
                </ul>
                <div class="d-flex align-items-center ms-lg-3 gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text text-white small">Olá, @User.Identity.Name</span>
                        <form asp-controller="Login" asp-action="Sair" method="post"><button class="btn btn-sm btn-outline-light" type="submit">Sair</button></form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" asp-controller="Login" asp-action="Index">Entrar</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>
<main class="container py-4">
    @if (TempData["Mensagem"] != null) { <div class="alert alert-success">@TempData["Mensagem"]</div> }
    @if (TempData["Erro"] != null) { <div class="alert alert-warning">@TempData["Erro"]</div> }
    @RenderBody()
</main>
<footer class="border-top py-3 mt-5 text-center text-muted"><small>Clínica Caramelo · Cuidado simples, carinho de verdade.</small></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
