@model LoginViewModel
@{ ViewData["Title"] = "Entrar"; Layout = "_Layout"; }
<div class="row justify-content-center py-4"><div class="col-12 col-md-7 col-lg-5">
<div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
<h1 class="h3 mb-2">Entrar na Clínica Caramelo</h1><p class="text-muted mb-4">Acesse o painel de atendimento.</p>
<form asp-action="Index" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="username"/><span asp-validation-for="Email" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Senha" class="form-label"></label><input asp-for="Senha" class="form-control" autocomplete="current-password"/><span asp-validation-for="Senha" class="text-danger"></span></div>
<input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
<button class="btn btn-caramelo w-100" type="submit">Entrar</button>
</form><hr/><small class="text-muted">Acesso inicial para demonstração: admin@caramelo.com.br / Caramelo@123</small>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
